{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "composite": true,
    "paths": {
      "@e-companies/shared": ["../e-companies-shared/index.ts"],
      "@e-companies/shared/*": ["../e-companies-shared/*"]
    }
  },
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "../e-companies-shared/**/*"]
}

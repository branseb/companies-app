{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "composite": true,
    "types": ["vite/client"],
    "paths": {
      "@e-companies/shared": ["../e-companies-shared/index.ts"],
      "@e-companies/shared/*": ["../e-companies-shared/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "../e-companies-shared/**/*"]
}
